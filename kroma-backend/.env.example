# ---- Kroma backend (.env) ----
# En Render: pon estas mismas claves en "Environment".

PORT=3000

# MongoDB Atlas (Database -> Connect -> Drivers). Incluye el nombre de BD (/kroma).
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/kroma?retryWrites=true&w=majority

# APIs externas (gratuitas). Pexels y Unsplash ya las tienes.
PEXELS_API_KEY=tu_clave_pexels
UNSPLASH_ACCESS_KEY=tu_clave_unsplash
PIXABAY_API_KEY=tu_clave_pixabay

# Secreto para disparar la ingesta:  POST /ingest?secret=...
INGEST_SECRET=pon-un-secreto-largo

# Token que la app envía (cabecera x-premium-token) cuando el usuario es PRO.
# Debe coincidir con KROMA_PREMIUM_TOKEN en la app (GitHub Secret).
PREMIUM_TOKEN=token-premium-para-suscriptores

# Proporción de fondos marcados como premium (0.25 = 25%).
PREMIUM_RATE=0.25

# ---- Motor HD "Nano Banana" (Gemini 2.5 Flash Image) ----
# Clave de Google AI Studio (https://aistudio.google.com/apikey).
# Sin ella, /generate responde 503 y la app usa pollinations flux como respaldo.
GEMINI_API_KEY=tu_clave_de_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash-image

# URL pública del servicio en Render (para servir las imágenes en /img).
# Si se deja vacío, se deduce de la cabecera Host de cada petición.
PUBLIC_BASE_URL=https://kroma.onrender.com
